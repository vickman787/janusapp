# Public Monad testnet configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
# Browser wallets use the public Monad RPC. Keep paid RPC credentials server-only.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.testnet.monad.xyz
NEXT_PUBLIC_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
NEXT_PUBLIC_JANUS_SETTLER_ADDRESS=0x1c3F1382057F99b5dAd89855B919bB322792C66E
NEXT_PUBLIC_JANUS_SPLIT_CONTRACT=0x1c3F1382057F99b5dAd89855B919bB322792C66E
# New splits use V2; stored split records retain the contract that created them.
NEXT_PUBLIC_JANUS_SPLIT_V2_CONTRACT=0xE9B9C0e09819857D8aa32b1dD749B26F58E43eD1
NEXT_PUBLIC_AGORA_FAUCET_ADDRESS=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Server-side Privy token verification. The App ID may match the public App ID.
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_server_only_privy_app_secret
PRIVY_API_BASE_URL=https://api.privy.io

# Server-side RPC and deployment configuration
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
QUICKNODE_RPC_URL=your_server_only_paid_rpc_url
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
PRIVATE_KEY=
JANUS_DATABASE_PATH=data/janus.sqlite

# Supabase hosted persistence (server-only; never expose the service key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Optional gas reporting
REPORT_GAS=false
CMC_API_KEY=

# Optional Tenderly simulation
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=janus-monad

# Optional integrations
ZERION_API_KEY=
