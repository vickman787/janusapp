{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["hardhat.config.ts", "test-hardhat/**/*.ts", "script/**/*.ts"],
  "exclude": ["node_modules", "artifacts", "cache-hardhat"]
}
